FROM eclipse-temurin:21-jre

LABEL description="Metabase with DuckDB JDBC driver for Sales Analytics"

ENV MB_PLUGINS_DIR=/app/plugins
ENV MB_DB_TYPE=h2
ENV MB_DB_FILE=/data/metabase/metabase.db
ENV MB_LOAD_SAMPLE_CONTENT=false

# Install curl for healthcheck + libs for DuckDB compatibility
RUN apt-get update && apt-get install -y curl libicu-dev libstdc++-13-dev && rm -rf /var/lib/apt/lists/*

# Create directories
RUN mkdir -p /app/plugins /data/metabase /data/warehouse

# Download Metabase
RUN curl -L -o /app/metabase.jar \
    https://downloads.metabase.com/v0.53.7/metabase.jar

# Download DuckDB Metabase driver
RUN curl -L -o /app/plugins/duckdb.metabase-driver.jar \
    https://github.com/motherduckdb/metabase_duckdb_driver/releases/download/1.5.4.0/duckdb.metabase-driver.jar


WORKDIR /app

HEALTHCHECK --interval=30s --timeout=10s --retries=5 \
    CMD curl -f http://localhost:3000/api/health || exit 1

EXPOSE 3000

CMD ["java", "-jar", "metabase.jar"]
