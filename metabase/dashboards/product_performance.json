{
    "name": "Product Performance",
    "description": "Deep dive into product metrics, sales rankings, and profit margins",
    "parameters": [
        {
            "id": "date_range",
            "name": "Date Range",
            "slug": "date_range",
            "type": "date/all-options",
            "sectionId": "date",
            "default": "past30days"
        },
        {
            "id": "category",
            "name": "Category",
            "slug": "category",
            "type": "category",
            "sectionId": null,
            "default": null
        }
    ],
    "cards": [
        {
            "name": "Product Rankings",
            "display": "text",
            "row": 0,
            "col": 0,
            "size_x": 24,
            "size_y": 1,
            "text_content": "## Product Rankings"
        },
        {
            "name": "Top 10 Products by Revenue",
            "display": "bar",
            "row": 1,
            "col": 0,
            "size_x": 12,
            "size_y": 6,
            "native_query": "SELECT product_name AS \"Product\", ROUND(SUM(net_revenue), 2) AS \"Revenue\" FROM main_gold.obt_sales WHERE 1=1 [[AND {{date_range}}]] [[AND {{category}}]] GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
            "template_tags": {
                "date_range": {
                    "name": "date_range",
                    "display_name": "Date Range",
                    "type": "dimension",
                    "dimension": ["field", "order_date", {"base-type": "type/Date"}],
                    "widget-type": "date/all-options",
                    "required": false,
                    "default": "past30days"
                },
                "category": {
                    "name": "category",
                    "display_name": "Category",
                    "type": "dimension",
                    "dimension": ["field", "category", {"base-type": "type/Text"}],
                    "widget-type": "category",
                    "required": false
                }
            },
            "parameter_mappings": [
                {
                    "parameter_id": "date_range",
                    "target": ["variable", ["template-tag", "date_range"]]
                },
                {
                    "parameter_id": "category",
                    "target": ["variable", ["template-tag", "category"]]
                }
            ]
        },
        {
            "name": "Revenue by Category",
            "display": "bar",
            "row": 1,
            "col": 12,
            "size_x": 12,
            "size_y": 6,
            "native_query": "SELECT category AS \"Category\", ROUND(SUM(net_revenue), 2) AS \"Revenue\" FROM main_gold.obt_sales WHERE 1=1 [[AND {{date_range}}]] GROUP BY 1 ORDER BY 2 DESC",
            "template_tags": {
                "date_range": {
                    "name": "date_range",
                    "display_name": "Date Range",
                    "type": "dimension",
                    "dimension": ["field", "order_date", {"base-type": "type/Date"}],
                    "widget-type": "date/all-options",
                    "required": false,
                    "default": "past30days"
                }
            },
            "parameter_mappings": [
                {
                    "parameter_id": "date_range",
                    "target": ["variable", ["template-tag", "date_range"]]
                }
            ]
        },
        {
            "name": "Profit Analysis",
            "display": "text",
            "row": 3,
            "col": 0,
            "size_x": 24,
            "size_y": 1,
            "text_content": "## Profit Analysis"
        },
        {
            "name": "Profit Margin & Gross Profit by Product",
            "display": "table",
            "row": 4,
            "col": 0,
            "size_x": 24,
            "size_y": 6,
            "native_query": "SELECT product_name AS \"Product\", category AS \"Category\", ROUND(AVG(profit_margin_pct), 2) AS \"Avg Margin %\", ROUND(SUM(gross_profit), 2) AS \"Total Profit\" FROM main_gold.obt_sales WHERE 1=1 [[AND {{date_range}}]] [[AND {{category}}]] GROUP BY 1, 2 ORDER BY 4 DESC LIMIT 15",
            "template_tags": {
                "date_range": {
                    "name": "date_range",
                    "display_name": "Date Range",
                    "type": "dimension",
                    "dimension": ["field", "order_date", {"base-type": "type/Date"}],
                    "widget-type": "date/all-options",
                    "required": false,
                    "default": "past30days"
                },
                "category": {
                    "name": "category",
                    "display_name": "Category",
                    "type": "dimension",
                    "dimension": ["field", "category", {"base-type": "type/Text"}],
                    "widget-type": "category",
                    "required": false
                }
            },
            "parameter_mappings": [
                {
                    "parameter_id": "date_range",
                    "target": ["variable", ["template-tag", "date_range"]]
                },
                {
                    "parameter_id": "category",
                    "target": ["variable", ["template-tag", "category"]]
                }
            ]
        }
    ]
}