{
    "name": "Product Performance",
    "description": "Product-level sales analysis and profitability",
    "cards": [
        {
            "name": "Top Products by Units Sold",
            "display": "bar",
            "row": 0,
            "col": 0,
            "size_x": 8,
            "size_y": 6,
            "query": {
                "query": {
                    "aggregation": [["sum", ["field", "quantity", null]]],
                    "breakout": [["field", "product_name", null]],
                    "order-by": [["desc", ["aggregation", 0]]],
                    "limit": 10
                }
            }
        },
        {
            "name": "Revenue by Category Over Time",
            "display": "area",
            "row": 0,
            "col": 8,
            "size_x": 8,
            "size_y": 6,
            "query": {
                "query": {
                    "aggregation": [["sum", ["field", "net_revenue", null]]],
                    "breakout": [["field", "order_year", null], ["field", "category", null]]
                }
            }
        },
        {
            "name": "Profit Margin by Product",
            "display": "scatter",
            "row": 6,
            "col": 0,
            "size_x": 8,
            "size_y": 6,
            "query": {
                "query": {
                    "aggregation": [["avg", ["field", "profit_margin_pct", null]]],
                    "breakout": [["field", "product_name", null]]
                }
            }
        },
        {
            "name": "Product Category Distribution",
            "display": "pie",
            "row": 6,
            "col": 8,
            "size_x": 8,
            "size_y": 6,
            "query": {
                "query": {
                    "aggregation": [["count", []]],
                    "breakout": [["field", "category", null]]
                }
            }
        }
    ]
}
