{
    "name": "Sales Overview",
    "description": "High-level sales performance metrics and trends",
    "cards": [
        {
            "name": "Total Revenue Over Time",
            "display": "line",
            "row": 0,
            "col": 0,
            "size_x": 8,
            "size_y": 6,
            "query": {
                "source-table": null,
                "query": {
                    "source-query": {
                        "source-table": null,
                        "aggregation": [["sum", ["field", "net_revenue", null]]],
                        "breakout": [["field", "order_month", {"source-field": "order_date_sk"}]]
                    }
                }
            }
        },
        {
            "name": "Revenue by Product Category",
            "display": "bar",
            "row": 0,
            "col": 8,
            "size_x": 8,
            "size_y": 6,
            "query": {
                "query": {
                    "aggregation": [["sum", ["field", "net_revenue", null]]],
                    "breakout": [["field", "category", null]]
                }
            }
        },
        {
            "name": "Sales by Day of Week",
            "display": "bar",
            "row": 6,
            "col": 0,
            "size_x": 8,
            "size_y": 6,
            "query": {
                "query": {
                    "aggregation": [["count", []]],
                    "breakout": [["field", "order_day_name", null]]
                }
            }
        },
        {
            "name": "Top 10 Customers by Revenue",
            "display": "table",
            "row": 6,
            "col": 8,
            "size_x": 8,
            "size_y": 6,
            "query": {
                "query": {
                    "aggregation": [["sum", ["field", "net_revenue", null]]],
                    "breakout": [["field", "customer_id", null], ["field", "first_name", null], ["field", "last_name", null]],
                    "order-by": [["desc", ["aggregation", 0]]],
                    "limit": 10
                }
            }
        }
    ]
}
